# ── Private Gate Pass — web ──────────────────────────────────────────
# No config is required: the app runs end-to-end out of the box.

# DEMO_MODE (default ON) stubs wallet signing with fixtures so the full UI flow
# works with no wallet — used for the demo screenshots. The live public counter
# (gate_access_count) is still read from the real testnet chain.
#
# Set this to false to drive a REAL wallet (Shield / Puzzle / Leo / Fox) and
# submit real transactions instead.
NEXT_PUBLIC_DEMO_MODE=true


# ── REAL mode (optional): button clicks = genuine on-chain txs ────────
# Drives real execution through a server-side Leo CLI backend
# (src/app/api/execute) — no wallet, and the signing key never reaches the
# browser. Takes precedence over DEMO_MODE. Requires, on the server:
#   • `leo` installed (https://github.com/ProvableHQ/leo)
#   • the Leo program dir present, with its own .env holding PRIVATE_KEY
#
# Copy this file to .env.local and uncomment to enable. NEVER commit .env.local.
#
# NEXT_PUBLIC_REAL_MODE=true
#
# Absolute path to the Leo program (defaults to ../private_gate_pass).
# LEO_DIR=/absolute/path/to/private_gate_pass
#
# Optional dedicated RPC (e.g. QuickNode). Server-side only — NOT NEXT_PUBLIC,
# so the token never reaches the browser. Broadcasts far more reliably than the
# public endpoint, which intermittently returns Cloudflare 522. Leave unset to
# use the public endpoint. Put YOUR OWN token here, never a shared one.
# ALEO_ENDPOINT=https://<your-endpoint>.aleo-testnet.quiknode.pro/<token>/v2
